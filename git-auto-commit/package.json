{
  "name": "git-auto-commit",
  "displayName": "Git-Auto-Commit",
  "description": "git auto commit feature for ECE-327",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.97.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:git-auto-commit.autoCommit"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
    "command": "git-auto-commit.autoCommit",
    "title": "Auto Git Commit"
      }
    ],
    "keybindings": [
      {
        "command": "git-auto-commit.autoCommit",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.97.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "eslint": "^9.19.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1"
  }
}
